PORT=5000
NODE_ENV=development

# Database Configuration:
# - Local usage: SQLite3 (auto-created at server/data/lifepilot.sqlite3 with zero setup)
# - Browser / Cloud deployment: MongoDB (MongoDB Atlas connection string)
DB_MODE=auto
SQLITE_PATH=./data/lifepilot.sqlite3
MONGODB_URI=mongodb://127.0.0.1:27017/lifepilot
JWT_SECRET=lifepilot_hackathon_super_secret_jwt_2026
JWT_EXPIRES_IN=7d
AI_PROVIDER=auto
BHARATCODE_API_KEY=
BHARATCODE_BASE_URL=https://api.bharatcode.org/v1
GEMINI_API_KEY=
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

